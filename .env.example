# Copie para .env e ajuste os valores. O .env NÃO deve ser versionado.

# Chave usada para assinar as sessões/cookies do Flask.
# Mantém os logins válidos entre reinícios — gere uma chave forte em produção:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-forte

# Banco de dados (SQLAlchemy). Padrão: SQLite local em instance/contracts.db.
# Para PostgreSQL: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=sqlite:///contracts.db
